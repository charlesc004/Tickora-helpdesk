<div class="pagination">
<span>Showing @(Total == 0 ? 0 : (Page - 1) * Size + 1)–@Math.Min(Page * Size, Total) of @Total @Noun</span>
<div>
<AppButton Variant="secondary small" Disabled="@(Page <= 1)" OnClick="() => Changed.InvokeAsync(Page - 1)">Previous</AppButton>
<span class="page-number">@Page / @Math.Max(1, (int)Math.Ceiling((double)Total / Size))</span>
<AppButton Variant="secondary small" Disabled="@(Page * Size >= Total)" OnClick="() => Changed.InvokeAsync(Page + 1)">Next</AppButton>
</div>
</div>
@code {
  [Parameter] public int Page { get; set; } = 1;
  [Parameter] public string Noun { get; set; } = "tickets";
  [Parameter] public int Size { get; set; } = 12;
  [Parameter] public int Total { get; set; }
  [Parameter] public EventCallback<int> Changed { get; set; }
}
